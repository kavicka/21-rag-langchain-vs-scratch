# Copy to .env (git-ignored). No secrets are needed: the data is public and the LLM runs locally.
LLM_PROVIDER=transformers        # transformers (measured run) | ollama (Mac default) | fake (tests)
LLM_MODEL=Qwen/Qwen3-1.7B        # Hugging Face id for transformers, or an Ollama tag such as qwen3:4b
# QDRANT_URL=http://localhost:6333   # empty = embedded local Qdrant in data/
